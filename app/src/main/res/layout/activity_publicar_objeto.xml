<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PublicarObjetoActivity">

    <EditText
        android:id="@+id/textView"
        android:layout_width="166dp"
        android:layout_height="44dp"
        android:hint="Username"
        android:inputType="text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.131" />

    <RadioGroup
        android:id="@+id/rgCategorias"
        android:layout_width="187dp"
        android:layout_height="160dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <RadioButton
            android:id="@+id/rbCategoria1"
            android:layout_width="144dp"
            android:layout_height="wrap_content"
            android:text="Ropa" />

        <RadioButton
            android:id="@+id/rbCategoria2"
            android:layout_width="172dp"
            android:layout_height="wrap_content"
            android:text="Libros" />

        <RadioButton
            android:id="@+id/rbCategoria3"
            android:layout_width="176dp"
            android:layout_height="wrap_content"
            android:text="Tecnologia" />
    </RadioGroup>

    <Button
        android:id="@+id/button2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rgCategorias" />


</androidx.constraintlayout.widget.ConstraintLayout>